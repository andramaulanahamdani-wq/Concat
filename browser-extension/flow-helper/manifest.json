{
  "manifest_version": 3,
  "name": "Flow Helper - Unduh Massal & Antrean Prompt",
  "short_name": "Flow Helper",
  "version": "1.0.0",
  "description": "Pembantu tidak resmi untuk Google Flow: unduh banyak gambar sekaligus (file/ZIP), auto-unduh, antrean prompt, pustaka prompt, dan lembar kontak.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Flow Helper",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "downloads",
    "storage",
    "offscreen",
    "contextMenus",
    "notifications"
  ],
  "host_permissions": [
    "https://labs.google/*",
    "https://*.googleusercontent.com/*",
    "https://*.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/*"
      ],
      "js": [
        "lib/common.js",
        "lib/settings-form.js",
        "content/scanner.js",
        "content/flow-input.js",
        "content/queue.js",
        "content/panel.js",
        "content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/panel.css",
        "icons/icon48.png"
      ],
      "matches": [
        "https://labs.google/*"
      ]
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Tampilkan / sembunyikan panel Flow Helper"
    },
    "download-selected": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Unduh gambar terpilih (atau semua bila tidak ada yang dipilih)"
    },
    "download-zip": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "Unduh gambar terpilih sebagai satu ZIP"
    }
  }
}
